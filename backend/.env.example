# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME=RecoverAI
ENVIRONMENT=development
DEBUG=true

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (default – zero install, good for demo)
DATABASE_URL=sqlite+aiosqlite:///./recoverai.db

# PostgreSQL (swap in for production)
# DATABASE_URL=postgresql+asyncpg://recoverai:recoverai@localhost:5432/recoverai

# ─── Razorpay (sandbox / test credentials only) ───────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_test_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ─── Gemini (optional – RCA reasoning text only) ─────────────────────────────
# If not set, RCA agent falls back to deterministic template text
GEMINI_API_KEY=your_gemini_api_key_here

# ─── CORS ────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
